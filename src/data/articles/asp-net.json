d"]},{"t":"text","v":"” and provide the specified permissions."}]}],[{"type":"paragraph","content":[{"t":"text","v":"If there isn’t a machine key looking at the "},{"t":"text","v":"last modified date ","marks":["bold"]},{"t":"text","v":"copy the MachineKey:"},{"t":"br"},{"t":"text","v":" From: “"},{"t":"text","v":"C:\\Documents and Settings\\All Users\\ApplicationData\\Microsoft\\Crypto\\RSA\\MachineKeys","marks":["bold"]},{"t":"text","v":"“,To: “"},{"t":"text","v":"C:\\ProgramData\\Microsoft\\Crypto\\RSA\\MachineKeys","marks":["bold"]},{"t":"text","v":"“."}]}]]},{"type":"paragraph","content":[{"t":"text","v":"C] Now, instead of loading certificates from the "},{"t":"text","v":"mo_cert ","marks":["bold"]},{"t":"text","v":"folder, we will pick the certificate from the "},{"t":"text","v":"Local Machine KeyStore ","marks":["bold"]},{"t":"text","v":"from within the module. So, once you have completed the above steps, please let us know and we will provide you with the updated module."}]},{"type":"paragraph","content":[{"t":"text","v":"If you continue to experience problems despite all of this, please feel free to contact us at "},{"t":"link","href":"mailto:aspnetsupport@xecurify.com","children":[{"t":"text","v":"aspnetsupport@xecurify.com"}]},{"t":"text","v":"."}]}],"i-am-not-able-to-find-my-idp-in-the-idp-list":[{"type":"paragraph","content":[{"t":"text","v":"Choose the "},{"t":"text","v":"custom IDP","marks":["bold"]},{"t":"text","v":" from the given IDP list."}]},{"type":"paragraph","content":[{"t":"text","v":"If you continue to experience problems despite all of this, please feel free to contact us at "},{"t":"link","href":"mailto:aspnetsupport@xecurify.com","children":[{"t":"text","v":"aspnetsupport@xecurify.com"}]},{"t":"text","v":"."}]}],"signed-request-not-working-for-azure-appservices":[{"type":"paragraph","content":[{"t":"text","v":"To load a certificate file in a .NET app, load the current user profile with the following command in the "},{"t":"link","href":"