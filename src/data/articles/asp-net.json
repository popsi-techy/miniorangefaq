graph","content":[{"t":"text","v":"Step 2","marks":["underline","bold"]},{"t":"text","v":": Move to the Account Setup tab –","marks":["bold"]},{"t":"text","v":" From the plugin dashboard on your application, you can move to the account setup tab from the top right corner, As shown in image below:"}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2024/04/asp.net-application-login.webp","alt":"","width":1862,"height":613},{"type":"paragraph","content":[{"t":"text","v":"Step 3","marks":["underline","bold"]},{"t":"text","v":":"},{"t":"text","v":" You can Now fetch the updated license expiry using the below two methods.","marks":["bold"]}]},{"type":"paragraph","content":[{"t":"text","v":"A] Using Fetch License Button","marks":["bold"]},{"t":"text","v":": Click on the fetch license button then the plugin will fetch the latest licensing details and extend your SSO service."}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2024/04/asp.net-fetch-license-details.webp","alt":"","width":1901,"height":747},{"type":"paragraph","content":[{"t":"text","v":"B] Using Deactivate License Button","marks":["bold"]},{"t":"text","v":": Click on the deactivate license button to deactivate the current license. Enter your license key to reactivate the license, the plugin will fetch the latest licensing details and extend your SSO service."}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2024/04/asp.net-application-deactivate-license.webp","alt":"","width":1062,"height":506}]}
