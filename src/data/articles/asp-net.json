":"text","v":"certificate import wizard","marks":["bold"]},{"t":"text","v":", then click “"},{"t":"text","v":"Next","marks":["bold"]},{"t":"text","v":"“."}]}],[{"type":"paragraph","content":[{"t":"text","v":"Enter your .PFX password if you have set or click “"},{"t":"text","v":"Next","marks":["bold"]},{"t":"text","v":"“."}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2023/02/asp-net-enter-pfx-password-300x295.webp","alt":"","width":300,"height":295}],[{"type":"paragraph","content":[{"t":"text","v":"Click on “"},{"t":"text","v":"Place all certificates in the following store","marks":["bold"]},{"t":"text","v":"“ and then on “"},{"t":"text","v":"Browse","marks":["bold"]},{"t":"text","v":"“."}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2023/02/asp-net-place-all-certificates.webp","alt":"","width":655,"height":643}],[{"type":"paragraph","content":[{"t":"text","v":"Select the “"},{"t":"text","v":"Trusted Root Certification Authorities","marks":["bold"]},{"t":"text","v":"“ folder."}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2023/02/asp-net-select-trusted-authorities.webp","alt":"","width":664,"height":647}],[{"type":"paragraph","content":[{"t":"text","v":"After a successful import, you will see the dialog box with the message: “"},{"t":"text","v":"The Import was successful.","marks":["bold"]},{"t":"text","v":"“ then click ”"},{"t":"text","v":"OK","marks":["bold"]},{"t":"text","v":"”."}]}]]}],[{"type":"paragraph","content":[{"t":"text","v":"Using Microsoft Management Console","marks":["bold"]},{"t":"text","v":":"}]},{"type":"list","ordered":false,"items":[[{"type":"paragraph","content":[{"t":"text","v":"Run “"},{"t":"text","v":"mmc","marks":["bold"]},{"t":"text","v":"“, Click “"},{"t":"text","v":"File","marks":["bold"]},{"t":"text","v":"“ ==> “"},{"t":"text","v":"Add/Remove Snap-In","marks":["bold"]},{"t":"text","v":"“."}]},{"type":"image","src":"http://faq.miniorange.in/