{"how-to-gain-access-to-my-website-if-i-get-locked-out":[{"type":"heading","level":4,"content":[{"t":"text","v":"If you are locked out please, try below one of the below solutions:"}]},{"type":"list","ordered":false,"items":[[{"type":"paragraph","content":[{"t":"text","v":"If you had setup KBA questions earlier, you can use them as an alternate method to login to your website. ( if the backup method is available in your plugin version )"}]}],[{"type":"paragraph","content":[{"t":"text","v":"In the WordPress database, in the "},{"t":"text","v":"wp_options","marks":["bold"]},{"t":"text","v":" table, search for "},{"t":"text","v":"mo2f_activate_plugin","marks":["bold"]},{"t":"text","v":" key and update its value to "},{"t":"text","v":"0","marks":["bold"]},{"t":"text","v":". 2FA will get disabled and you will be able to login to your site with your WP username + password. After entering the site, you can reconfigure your 2FA method."}]}],[{"type":"paragraph","content":[{"t":"text","v":"If you have FTP access, please follow the below steps:"}]},{"type":"list","ordered":true,"items":[[{"type":"paragraph","content":[{"t":"text","v":"Open your WordPress installation folder. Go to "},{"t":"text","v":"wp-content","marks":["bold"]},{"t":"text","v":" –> plugins folder."}]}],[{"type":"paragraph","content":[{"t":"text","v":"You will see "},{"t":"text","v":"miniorange-2-factor-authentication","marks":["bold"]},{"t":"text","v":" folder."}]}],[{"type":"paragraph","content":[{"t":"text","v":"Rename the folder (Do not change anything else). It will deactivate the plugin."}]}],[{"type":"paragraph","content":[{"t":"text","v":"Now login to your site."}]}],[{"type":"paragraph","content":[{"t":"text","v":"You can activate again from Plugins –> Installed plugins."}]}]]}]]},{"type":"heading","level":4,"content":[{"t":"text","v":"You can also check our video Tutorial:"}]},{"type":"video","provider":"youtube","videoId":"wLFKakQkpk8","title":"Video"}],"change-google-authenticator-name":[{"type":