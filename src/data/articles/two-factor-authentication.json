":["bold"]},{"t":"text","v":" plugin, and then click on the "},{"t":"text","v":"Settings","marks":["bold"]},{"t":"text","v":" subtab."}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2020/06/go-settings-tab-1024x378.webp","alt":"","width":855,"height":315}]]},{"type":"list","ordered":false,"items":[[{"type":"paragraph","content":[{"t":"text","v":"By clicking the "},{"t":"text","v":"plus","marks":["bold"]},{"t":"text","v":" button, you can select multiple user roles. There, you can enter role-wise custom redirect URLs."}]}],[{"type":"paragraph","content":[{"t":"text","v":"Then click on the "},{"t":"text","v":"Save Settings","marks":["bold"]},{"t":"text","v":" button."}]}],[{"type":"paragraph","content":[{"t":"text","v":"Example:","marks":["bold"]},{"t":"text","v":" In the image below, I have set a custom redirect login URL for three different user roles."}]},{"type":"image","src":"http://faq.miniorange.in/wp-content/uploads/sites/10/2020/06/click-save-settings-button-1024x391.webp","alt":"","width":855,"height":326}]]},{"type":"paragraph","content":[{"t":"text","v":"Now when any of the three users log in to the site, they will be redirected to the Custom Redirect login URL page."}]},{"type":"heading","level":4,"content":[{"t":"text","v":"OR"}]},{"type":"paragraph","content":[{"t":"text","v":"If you are using the free plugin, this feature is available in the premium version. Please check out our pricing here: "},{"t":"link","href":"https://plugins.miniorange.in/2-factor-authentication-for-wordpress-wp-2fa#pricing","children":[{"t":"text","v":"2FA Premium Plan","marks":["bold"]}]}]},{"type":"paragraph","content":[{"t":"text","v":"If you have any questions, feel free to email our support team at "},{"t":"link","href":"mailto:mfasupport@xecurify.com","children":[{"t":"text","v":"mfasupport@xecurify.com","marks":["bold"]},{"t":"text","v":"."}]},{"t":"text","v":" We are happy to help."}]}],"users-not-prompted-2-factor-login":[{"type":"heading